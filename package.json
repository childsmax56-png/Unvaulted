{
  "name": "vaultgold-unified",
  "private": true,
  "version": "1.0.3",
  "description": "UNVAULTED — The Best Music Trackers In The World",
  "author": "UNVAULTED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "app:dev": "electron .",
    "app:build": "electron-builder",
    "app:build:mac": "electron-builder --mac",
    "app:build:win": "electron-builder --win",
    "app:build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "cc.unvaulted.desktop",
    "productName": "UNVAULTED",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "afterPack": "electron/vmp-sign.cjs",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/",
      "customDir": "v42.5.2+wvcus"
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "synopsis": "The Best Music Trackers In The World",
      "maintainer": "UNVAULTED <childsmax56@gmail.com>",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "aws4fetch": "^1.0.20",
    "axios": "^1.13.6",
    "browser-id3-writer": "^6.3.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.6.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "https://github.com/castlabs/electron-releases#v42.5.2+wvcus",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
